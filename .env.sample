# Twitch bot credentials (required when TF2_ENABLE_TWITCH_BOT=true)
TWITCH_BOT_USER=your_bot_username
TWITCH_BOT_OAUTH=oauth:your_oauth_token

# Channels to join (required when TF2_ENABLE_TWITCH_BOT=true)
# Comma/space-separated list
TWITCH_CHANNELS=streamer_channel

# Optional channels where the bot is a moderator (affects rate limits)
TWITCH_MOD_CHANNELS=

# Optional debug logging for Twitch chat
TWITCH_DEBUG=false

# Folder shared with the Transport Fever 2 mod
TF2_INTEGRATION_GAME_FILES=/tmp/tf2

# Optional: disable starting the Twitch bot entirely by setting this to false
TF2_ENABLE_TWITCH_BOT=true
